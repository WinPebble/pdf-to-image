<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../branding/WinPebble.ico" LogicalName="WinPebble.BrandIcon" />
    <Compile Include="../../src/WinPebble.PDFToImage/Conversion/*.cs" Link="Conversion/%(Filename)%(Extension)" />
    <Compile Include="../../src/WinPebble.PDFToImage/OutputFormat.cs" Link="OutputFormat.cs" />
    <Compile Include="../../src/WinPebble.PDFToImage/UI/ProgressWindow.cs" Link="UI/ProgressWindow.cs" />
  </ItemGroup>
</Project>
